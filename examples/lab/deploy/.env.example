# Copy to .env (never commit .env) and change the secrets.
POSTGRES_PASSWORD=change-me
APP_PORT=28090

# Execution state in PostgreSQL (the DSN is built by compose from POSTGRES_PASSWORD).
TURBINE_SYSDB=postgres
TURBINE_SYSDB_OPTIONS=schema=turbine,max_conns=20,poll_interval=500ms
TURBINE_EXECUTOR_ID=lab-1
TURBINE_APP_VERSION=lab-1
TURBINE_GC_RETENTION=168h

# PocketBase superuser created/updated on every start.
LAB_SUPERUSER_EMAIL=admin@turbine.lab
LAB_SUPERUSER_PASSWORD=change-me-too

# Only when the repository is not at ../../.. relative to this file:
# BUILD_CONTEXT=./src
# DOCKERFILE=examples/lab/deploy/Dockerfile
